<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>枪林弹雨 V2 · 战役</title>
<style>
  html,body{margin:0;padding:0;background:#07100a;height:100%;overflow:hidden;
    font-family:"Microsoft YaHei","PingFang SC",sans-serif;color:#cfd8c0;}
  #wrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
  canvas{image-rendering:pixelated;background:#07100a;
    box-shadow:0 0 0 2px #243d1e,0 0 40px #000;max-width:100%;max-height:100%;}
  #tip{position:absolute;bottom:6px;left:0;right:0;text-align:center;font-size:12px;color:#4d6b3c;
    pointer-events:none;}
</style>
</head>
<body>
<div id="wrap"><canvas id="cv" width="960" height="540"></canvas></div>
<script>
"use strict";

/* ===================== 基础常量 ===================== */
var VW = 960, VH = 540;
var TILE = 20, COLS = 230, ROWS = 27;
var WORLD_W = COLS * TILE, WORLD_H = ROWS * TILE;

var cv = document.getElementById('cv');
var ctx = cv.getContext('2d');
ctx.imageSmoothingEnabled = false;

/* ===================== 基础调色板 ===================== */
var BASE = {
  sky1: '#0c1a12', sky2: '#1c3a22', hillFar: '#16361e', hillNear: '#1f4a28',
  grass: '#5a8c30', dirt: '#33491f', dirtDark: '#223015',
  steel: '#5a6068', steelDark: '#363b42', crate: '#8a5a26', crateDark: '#54340f',
  green: '#7fb03a', greenD: '#2f5a1c', red: '#d2422c', gold: '#e0bd3e',
  white: '#e7ecda', ink: '#0a1208', accent: '#46c8d8',
  cloud: 'rgba(255,255,255,0.10)', star: 'rgba(255,255,255,0.8)'
};
var TH = Object.assign({}, BASE);   // 当前关卡主题（drawWorld 使用）

/* ===================== 输入 ===================== */
var keys = {}, just = {};
var mouse = { x: VW / 2, y: VH / 2, down: false, click: false, rclick: false, wheel: 0 };

window.addEventListener('keydown', function (e) {
  // 登录 / 好友搜索：画布内文本输入
  if (state === 'login' || state === 'friends') {
    if (e.key === 'Escape') {
      if (state === 'friends') {
        if (blacklistView) blacklistView = false;
        else if (userListView) userListView = false;
        else if (statsView) statsView = false;
        else if (gfPassView) gfPassView = false;
        else if (friendReqView) friendReqView = false;
        else { friendPickMode = false; state = 'home'; }
      }
      return;
    }
    if (e.key === 'Enter') {
      if (state === 'login') tryLogin();
      else if (gfPassView) submitPass();
      else if (!userListView) addFriendByName(friendSearch);
      return;
    }
    if (e.key === 'Backspace') {
      if (state === 'login') loginFields[loginActive] = loginFields[loginActive].slice(0, -1);
      else if (gfPassView) gfPassBuf = gfPassBuf.slice(0, -1);
      else if (!userListView) friendSearch = friendSearch.slice(0, -1);
      e.preventDefault(); return;
    }
    if (e.key && e.key.length === 1) {
      if (state === 'login') { if (loginFields[loginActive].length < 16) loginFields[loginActive] += e.key; }
      else if (gfPassView) { if (gfPassBuf.length < 24) gfPassBuf += e.key; }
      else if (!userListView) { if (friendSearch.length < 16) friendSearch += e.key; updateSecret(e.key); }
      e.preventDefault(); return;
    }
    return;
  }
  if (!keys[e.code]) just[e.code] = true;
  keys[e.code] = true;
  if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].indexOf(e.code) >= 0) e.preventDefault();
});
window.addEventListener('keyup', function (e) {
  keys[e.code] = false;
});
window.addEventListener('blur', function () { keys = {}; mouse.down = false; grenAiming = false; });

cv.addEventListener('contextmenu', function (e) { e.preventDefault(); });
cv.addEventListener('mousemove', function (e) {
  var r = cv.getBoundingClientRect();
  mouse.x = (e.clientX - r.left) * (VW / r.width);
  mouse.y = (e.clientY - r.top) * (VH / r.height);
});
cv.addEventListener('mousedown', function (e) {
  var r = cv.getBoundingClientRect();
  mouse.x = (e.clientX - r.left) * (VW / r.width);
  mouse.y = (e.clientY - r.top) * (VH / r.height);
  if (e.button === 1) {            // 鼠标中键：发射手雷（按下瞄准、松开投掷）
    if (state === 'play' && player && !player.dead) grenAiming = true;
    e.preventDefault();            // 阻止浏览器中键自动滚动
    return;
  }
  if (e.button === 2) { mouse.rclick = true; e.preventDefault(); }
  else { mouse.down = true; mouse.click = true; }
});
window.addEventListener('mouseup', function (e) {
  if (e.button === 1) { if (grenAiming) { throwGren(); grenAiming = false; } return; }
  if (e.button === 2) mouse.rclick = false; else mouse.down = false;
});
cv.addEventListener('auxclick', function (e) { if (e.button === 1) e.preventDefault(); });
// 滚轮：用于黑名单等长列表滚动（每帧末尾复位，deltaY 累加进 mouse.wheel）
cv.addEventListener('wheel', function (e) { e.preventDefault(); mouse.wheel += e.deltaY; }, { passive: false });

/* ===================== 音效 ===================== */
var AC = null;
function actx() {
  if (!AC) { try { AC = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { AC = false; } }
  return AC;
}
function beep(freq, dur, type, vol) {
  var a = actx(); if (!a) return;
  try {
    var o = a.createOscillator(), g = a.createGain();
    o.type = type || 'square'; o.frequency.value = freq;
    g.gain.value = vol || 0.04;
    o.connect(g); g.connect(a.destination);
    g.gain.exponentialRampToValueAtTime(0.0001, a.currentTime + dur);
    o.start(); o.stop(a.currentTime + dur);
  } catch (e) {}
}
function boom() {
  var a = actx(); if (!a) return;
  try {
    var len = Math.floor(a.sampleRate * 0.4);
    var buf = a.createBuffer(1, len, a.sampleRate);
    var d = buf.getChannelData(0);
    for (var i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 2.2);
    var s = a.createBufferSource(); s.buffer = buf;
    var g = a.createGain(); g.gain.value = 0.22;
    s.connect(g); g.connect(a.destination); s.start();
  } catch (e) {}
}
var SFX = {
  shot: function () { beep(220 + Math.random() * 60, 0.07, 'square', 0.035); },
  mg: function () { beep(160 + Math.random() * 40, 0.04, 'sawtooth', 0.022); },
  sg: function () { beep(110, 0.14, 'sawtooth', 0.06); },
  rl: function () { beep(90, 0.1, 'square', 0.05); },
  hurt: function () { beep(150, 0.12, 'triangle', 0.07); },
  reload: function () { beep(320, 0.05, 'square', 0.04); setTimeout(function () { beep(200, 0.06, 'square', 0.04); }, 180); },
  die: function () { beep(120, 0.3, 'sawtooth', 0.06); },
  pick: function () { beep(520, 0.07, 'square', 0.04); },
  toss: function () { beep(400, 0.08, 'sine', 0.04); },
  setpt: function () { beep(660, 0.09, 'square', 0.05); setTimeout(function () { beep(880, 0.12, 'square', 0.05); }, 110); },
  crate: function () { beep(150, 0.05, 'square', 0.025); setTimeout(function () { beep(90, 0.05, 'square', 0.018); }, 28); },
  armor: function () { beep(900, 0.05, 'square', 0.05); },
  knife: function () { beep(320 + Math.random() * 90, 0.05, 'sawtooth', 0.03); },
  win: function () { beep(440, 0.12, 'square', 0.05); setTimeout(function () { beep(660, 0.12, 'square', 0.05); }, 140); setTimeout(function () { beep(880, 0.22, 'square', 0.05); }, 280); }
};

/* ===================== 武器定义 ===================== */
// dmg 为「敌方最大血量的百分比」
var WEAPONS = {
  pistol:  { key:'pistol',  name:'手枪',   kind:'pistol',  mag:10,  rate:280,  dmg:10, pellets:1, spread:0.025, range:520, speed:11, auto:false, reload:900 },
  shotgun: { key:'shotgun', name:'霰弹枪', kind:'primary', mag:10,  rate:780,  dmg:10, pellets:5, spread:0.20,  range:280, speed:9,  auto:false, reload:1200 },
  mg:      { key:'mg',      name:'机枪',   kind:'primary', mag:125, rate:67,   dmg:20, pellets:1, spread:0.085, range:640, speed:13, auto:true,  reload:2000 },
  rocket:  { key:'rocket',  name:'火箭炮', kind:'primary', mag:1,   rate:1200, dmg:100,pellets:1, spread:0.01,  range:700, speed:7,  auto:false, reload:2200, explosive:true, autoReload:true, pierce:1 },
  urocket: { key:'urocket', name:'超级火箭炮', kind:'primary', mag:10,  rate:1500, dmg:100,pellets:1, spread:0.01,  range:700, speed:7,  auto:false, reload:2200, explosive:true, autoReload:true, pierce:1, volley:5 },
  bounce:   { key:'bounce',  name:'反弹枪', kind:'primary', mag:100, rate:180,  dmg:10, pellets:1, spread:0.03,  range:560, speed:12, auto:true,  reload:1500, bounce:10, splash:5 },
  knife:    { key:'knife',   name:'刀',     kind:'melee',  mag:0,   rate:1000, dmg:0,  pellets:1, spread:0,      range:34,  speed:0,  auto:true,  reload:0 },
  sniper:   { key:'sniper',  name:'狙击枪', kind:'primary', mag:5,   rate:1300, dmg:85, pellets:1, spread:0.004, range:920, speed:20, auto:false, reload:1600, pierce:2 },
  smg:      { key:'smg',     name:'冲锋枪', kind:'primary', mag:40,  rate:85,   dmg:9,  pellets:1, spread:0.13,  range:360, speed:12, auto:true,  reload:1400 },
  rifle:    { key:'rifle',   name:'突击步枪', kind:'primary', mag:30, rate:130, dmg:18, pellets:1, spread:0.05,  range:600, speed:14, auto:true,  reload:1500 }
};

