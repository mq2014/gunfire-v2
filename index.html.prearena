/* ===================== 难度 ===================== */
// 简单=正常；困难=攻击-10%、敌方更快更敏锐；地狱=伤害-50%、敌方察觉范围50米
var DIFFS = [
  { key:'easy', name:'简单', dmgMul:1.0, espeed:1.0, detectM:0,  hearMul:1.0, alertT:6000, lenMul:1.0, eMul:1.0, dropMul:1.0, note:'最正常的体验' },
  { key:'hard', name:'困难', dmgMul:0.9, espeed:1.2, detectM:25, hearMul:1.4, alertT:6000, lenMul:1.2, eMul:1.3, dropMul:1.4, note:'攻击-10%，敌方更快更敏锐，地图更长、敌人更多，掉落更丰厚' },
  { key:'hell', name:'地狱', dmgMul:0.5, espeed:1.3, detectM:50, hearMul:1.7, alertT:6000, lenMul:1.5, eMul:1.5, dropMul:1.8, note:'伤害-50%，察觉范围50米，地图最长、敌人最多，掉落最丰厚，且出现抢旗手' }
];
var DIFFKEY = 0;                 // 0=简单 1=困难 2=地狱
var DIFF = DIFFS[DIFFKEY];

